{
  "meta": {
    "version": "1.0.0",
    "brand": "Samasta",
    "description": "Alur dan isian pembuatan undangan digital untuk berbagai jenis acara",
    "locale": "id-ID"
  },
  "eventTypes": [
    {
      "id": "wedding",
      "label": "Pernikahan",
      "description": "Undangan pernikahan digital lengkap dengan RSVP, galeri, dan kado"
    },
    {
      "id": "birthday",
      "label": "Ulang Tahun",
      "description": "Kartu undangan ulang tahun digital yang personal dan ceria"
    },
    {
      "id": "other",
      "label": "Acara Lainnya",
      "description": "Reuni, acara perusahaan, syukuran, dan perayaan lainnya"
    }
  ],
  "flow": [
    {
      "step": 1,
      "id": "register-and-event",
      "title": "Daftar & Lengkapi Data",
      "description": "Buat akun dan isi detail acara Anda",
      "fields": [
        {
          "key": "eventType",
          "label": "Jenis Acara",
          "type": "select",
          "required": true,
          "optionsSource": "eventTypes"
        },
        {
          "key": "eventTitle",
          "label": "Judul Undangan",
          "type": "text",
          "required": true,
          "placeholder": {
            "wedding": "Pernikahan Andi & Sinta",
            "birthday": "Ultah ke-25 Raka",
            "other": "Syukuran Keluarga"
          },
          "maxLength": 80
        },
        {
          "key": "hosts",
          "label": "Nama Penyelenggara",
          "type": "array",
          "required": true,
          "itemFields": [
            {
              "key": "name",
              "label": "Nama",
              "type": "text",
              "required": true
            },
            {
              "key": "role",
              "label": "Peran",
              "type": "text",
              "required": false,
              "placeholder": {
                "wedding": "Mempelai Pria / Mempelai Wanita",
                "birthday": "Yang berulang tahun / Orang tua",
                "other": "Penyelenggara"
              }
            }
          ],
          "minItems": 1,
          "maxItems": 4
        },
        {
          "key": "greeting",
          "label": "Kalimat Pembuka",
          "type": "textarea",
          "required": false,
          "placeholder": {
            "wedding": "Dengan memohon rahmat Tuhan, kami mengundang Bapak/Ibu/Saudara/i untuk hadir...",
            "birthday": "Kamu diundang merayakan hari spesialku! Yuk datang dan rayakan bersama.",
            "other": "Dengan senang hati kami mengundang Anda untuk hadir dalam acara kami."
          },
          "maxLength": 500
        },
        {
          "key": "events",
          "label": "Detail Acara",
          "type": "array",
          "required": true,
          "itemFields": [
            {
              "key": "name",
              "label": "Nama Acara",
              "type": "text",
              "required": true,
              "placeholder": {
                "wedding": "Akad / Resepsi",
                "birthday": "Pesta Ulang Tahun",
                "other": "Acara Utama"
              }
            },
            {
              "key": "date",
              "label": "Tanggal",
              "type": "date",
              "required": true
            },
            {
              "key": "startTime",
              "label": "Jam Mulai",
              "type": "time",
              "required": true
            },
            {
              "key": "endTime",
              "label": "Jam Selesai",
              "type": "time",
              "required": false
            },
            {
              "key": "venueName",
              "label": "Nama Tempat",
              "type": "text",
              "required": true
            },
            {
              "key": "venueAddress",
              "label": "Alamat Lengkap",
              "type": "textarea",
              "required": true
            },
            {
              "key": "mapsUrl",
              "label": "Link Google Maps",
              "type": "url",
              "required": false
            }
          ],
          "minItems": 1,
          "maxItems": 5
        },
        {
          "key": "dressCode",
          "label": "Dress Code",
          "type": "text",
          "required": false,
          "placeholder": "Casual / Formal / Warna pastel"
        },
        {
          "key": "notes",
          "label": "Catatan Tambahan",
          "type": "textarea",
          "required": false,
          "maxLength": 300
        }
      ]
    },
    {
      "step": 2,
      "id": "choose-theme",
      "title": "Pilih Tema Undangan",
      "description": "Pilih desain yang sesuai gaya perayaan",
      "fields": [
        {
          "key": "themeId",
          "label": "Tema",
          "type": "theme-picker",
          "required": true,
          "optionsSource": "themes"
        },
        {
          "key": "primaryColor",
          "label": "Warna Utama",
          "type": "color",
          "required": false,
          "default": "#4F46E5"
        },
        {
          "key": "accentColor",
          "label": "Warna Aksen",
          "type": "color",
          "required": false,
          "default": "#FB7185"
        },
        {
          "key": "coverImage",
          "label": "Foto Cover",
          "type": "image",
          "required": false,
          "accept": ["image/jpeg", "image/png", "image/webp"],
          "maxSizeMb": 5
        },
        {
          "key": "gallery",
          "label": "Galeri Foto & Video",
          "type": "media-gallery",
          "required": false,
          "maxItems": 20,
          "accept": ["image/jpeg", "image/png", "image/webp", "video/mp4"]
        },
        {
          "key": "backgroundMusic",
          "label": "Musik Latar",
          "type": "audio",
          "required": false,
          "accept": ["audio/mpeg", "audio/mp3"],
          "maxSizeMb": 10
        },
        {
          "key": "musicAutoplay",
          "label": "Putar Musik Otomatis",
          "type": "boolean",
          "required": false,
          "default": true
        }
      ]
    },
    {
      "step": 3,
      "id": "guest-list",
      "title": "Tambah Daftar Tamu",
      "description": "Import atau input tamu undangan",
      "fields": [
        {
          "key": "guests",
          "label": "Daftar Tamu",
          "type": "array",
          "required": false,
          "itemFields": [
            {
              "key": "name",
              "label": "Nama Tamu",
              "type": "text",
              "required": true
            },
            {
              "key": "phone",
              "label": "Nomor WhatsApp",
              "type": "tel",
              "required": false
            },
            {
              "key": "email",
              "label": "Email",
              "type": "email",
              "required": false
            },
            {
              "key": "group",
              "label": "Grup / Kategori",
              "type": "text",
              "required": false,
              "placeholder": "Keluarga / Teman / Kantor"
            },
            {
              "key": "quota",
              "label": "Kuota Kehadiran",
              "type": "number",
              "required": false,
              "default": 1,
              "min": 1,
              "max": 20
            },
            {
              "key": "personalizedGreeting",
              "label": "Sapaan Personal",
              "type": "text",
              "required": false,
              "placeholder": "Kepada Yth. Bapak/Ibu..."
            }
          ]
        },
        {
          "key": "importSource",
          "label": "Impor Tamu",
          "type": "file",
          "required": false,
          "accept": [
            "text/csv",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        },
        {
          "key": "rsvpEnabled",
          "label": "Aktifkan RSVP",
          "type": "boolean",
          "required": false,
          "default": true
        },
        {
          "key": "rsvpDeadline",
          "label": "Batas Konfirmasi RSVP",
          "type": "date",
          "required": false
        },
        {
          "key": "guestMessageEnabled",
          "label": "Aktifkan Ucapan & Doa",
          "type": "boolean",
          "required": false,
          "default": true
        }
      ]
    },
    {
      "step": 4,
      "id": "share",
      "title": "Bagikan Link & QR",
      "description": "Kirim undangan personal ke setiap tamu",
      "fields": [
        {
          "key": "slug",
          "label": "Link Undangan",
          "type": "slug",
          "required": true,
          "prefix": "https://samasta.app/u/",
          "placeholder": {
            "wedding": "andi-sinta",
            "birthday": "ultah-raka-25",
            "other": "acara-keluarga"
          }
        },
        {
          "key": "qrEnabled",
          "label": "Tampilkan QR Code unik per tamu",
          "type": "boolean",
          "required": false,
          "default": true
        },
        {
          "key": "shareChannels",
          "label": "Saluran Pembagian",
          "type": "multi-select",
          "required": false,
          "options": [
            { "id": "whatsapp", "label": "WhatsApp" },
            { "id": "link", "label": "Salin Link" },
            { "id": "qr", "label": "QR Code" },
            { "id": "instagram", "label": "Story Instagram" }
          ],
          "default": ["whatsapp", "link"]
        },
        {
          "key": "whatsappMessageTemplate",
          "label": "Template Pesan WhatsApp",
          "type": "textarea",
          "required": false,
          "placeholder": {
            "wedding": "Halo {{guestName}}, Anda diundang ke pernikahan {{hosts}}. Buka undangan: {{inviteUrl}}",
            "birthday": "Hai {{guestName}}! Kamu diundang ke ultah {{hosts}}. Cek detailnya di sini: {{inviteUrl}}",
            "other": "Halo {{guestName}}, Anda diundang ke {{eventTitle}}. Detail: {{inviteUrl}}"
          },
          "variables": ["guestName", "hosts", "eventTitle", "inviteUrl", "eventDate"]
        },
        {
          "key": "streamingUrl",
          "label": "Link Live Streaming",
          "type": "url",
          "required": false
        }
      ]
    },
    {
      "step": 5,
      "id": "monitor",
      "title": "Pantau RSVP & Kado",
      "description": "Kelola konfirmasi kehadiran dan hadiah",
      "fields": [
        {
          "key": "giftCashlessEnabled",
          "label": "Aktifkan Amplop Digital",
          "type": "boolean",
          "required": false,
          "default": false
        },
        {
          "key": "bankAccounts",
          "label": "Rekening Amplop Digital",
          "type": "array",
          "required": false,
          "visibleWhen": { "giftCashlessEnabled": true },
          "itemFields": [
            {
              "key": "bankName",
              "label": "Nama Bank",
              "type": "text",
              "required": true
            },
            {
              "key": "accountNumber",
              "label": "Nomor Rekening",
              "type": "text",
              "required": true
            },
            {
              "key": "accountHolder",
              "label": "Atas Nama",
              "type": "text",
              "required": true
            }
          ],
          "maxItems": 3
        },
        {
          "key": "giftShippingEnabled",
          "label": "Aktifkan Kirim ke Alamat",
          "type": "boolean",
          "required": false,
          "default": false
        },
        {
          "key": "shippingAddress",
          "label": "Alamat Penerima Kado",
          "type": "textarea",
          "required": false,
          "visibleWhen": { "giftShippingEnabled": true }
        },
        {
          "key": "wishlistEnabled",
          "label": "Aktifkan Wishlist Kado",
          "type": "boolean",
          "required": false,
          "default": false
        },
        {
          "key": "wishlistItems",
          "label": "Daftar Wishlist",
          "type": "array",
          "required": false,
          "visibleWhen": { "wishlistEnabled": true },
          "itemFields": [
            {
              "key": "name",
              "label": "Nama Barang",
              "type": "text",
              "required": true
            },
            {
              "key": "url",
              "label": "Link Produk",
              "type": "url",
              "required": false
            },
            {
              "key": "price",
              "label": "Perkiraan Harga",
              "type": "number",
              "required": false
            },
            {
              "key": "image",
              "label": "Foto Barang",
              "type": "image",
              "required": false
            }
          ],
          "maxItems": 30
        },
        {
          "key": "checkInEnabled",
          "label": "Aktifkan QR Check-in",
          "type": "boolean",
          "required": false,
          "default": false
        }
      ]
    }
  ],
  "themes": [
    {
      "id": "confetti-pop",
      "name": "Confetti Pop",
      "tag": "Ceria",
      "suitableFor": ["birthday", "other"],
      "gradient": "from-pink-100 to-amber-100"
    },
    {
      "id": "sky-serenade",
      "name": "Sky Serenade",
      "tag": "Modern",
      "suitableFor": ["wedding", "birthday", "other"],
      "gradient": "from-sky-100 to-indigo-50"
    },
    {
      "id": "color-parade",
      "name": "Color Parade",
      "tag": "Fun",
      "suitableFor": ["birthday", "other"],
      "gradient": "from-violet-100 to-fuchsia-50"
    },
    {
      "id": "soft-celebration",
      "name": "Soft Celebration",
      "tag": "Timeless",
      "suitableFor": ["wedding", "birthday", "other"],
      "gradient": "from-slate-100 to-sky-50"
    },
    {
      "id": "tropical-day",
      "name": "Tropical Day",
      "tag": "Outdoor",
      "suitableFor": ["birthday", "other"],
      "gradient": "from-cyan-100 to-emerald-50"
    },
    {
      "id": "midnight-spark",
      "name": "Midnight Spark",
      "tag": "Elegant",
      "suitableFor": ["wedding", "other"],
      "gradient": "from-indigo-900/20 to-slate-200"
    },
    {
      "id": "happy-hues",
      "name": "Happy Hues",
      "tag": "Playful",
      "suitableFor": ["birthday"],
      "gradient": "from-yellow-100 to-rose-50"
    },
    {
      "id": "aurora-pastel",
      "name": "Aurora Pastel",
      "tag": "Premium",
      "suitableFor": ["wedding", "birthday", "other"],
      "gradient": "from-fuchsia-100 to-indigo-100"
    }
  ],
